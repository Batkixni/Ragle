---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  titleZh="404 — Raglex"
  titleEn="404 — Raglex"
  titleJa="404 — Raglex"
  description="Page not found"
>
  <main
    class="container"
    style="min-height:70vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:16px;"
  >
    <span class="eyebrow">404</span>
    <h1 class="section-title" style="margin:0">Page Not Found</h1>
    <p class="section-sub">The page you requested does not exist.</p>
    <div style="display:flex;gap:10px;margin-top:8px">
      <a href="/" class="btn btn-primary" data-i18n-zh="回首頁" data-i18n-en="Home" data-i18n-ja="ホーム">回首頁</a>
      <a href="/docs" class="btn btn-secondary" data-i18n-zh="閱讀文件" data-i18n-en="Docs" data-i18n-ja="ドキュメント">閱讀文件</a>
    </div>
  </main>
</BaseLayout>
