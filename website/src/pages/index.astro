---
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";

const version = "0.5.1";
const releaseBase = `https://github.com/Batkixni/Raglex/releases/download/v${version}`;

interface Stage {
  id: string;
  num: string;
  img: string;
  alt: string;
  titleZh: string;
  titleEn: string;
  titleJa: string;
  leadZh: string;
  leadEn: string;
  leadJa: string;
  ctaHref?: string;
  ctaExt?: boolean;
  ctaZh?: string;
  ctaEn?: string;
  ctaJa?: string;
}

const stages: Stage[] = [
  {
    id: "native",
    num: "01 / 08",
    img: "/assets/inspector.png",
    alt: "Raglex Native Library & Inspector",
    titleZh: "純原生，秒啟動",
    titleEn: "Native. Fast.",
    titleJa: "純ネイティブ",
    leadZh: "Go 編譯 · 零 Electron",
    leadEn: "21 MB Go · Zero Electron",
    leadJa: "21 MB · 瞬時に起動",
  },
  {
    id: "index",
    num: "02 / 08",
    img: "/assets/shots/shot-index-delete.png",
    alt: "Non-destructive Index Mode & Safe Delete",
    titleZh: "索引不複製原檔",
    titleEn: "Zero Copy",
    titleJa: "複製せず管理",
    leadZh: "預設不動硬碟原檔",
    leadEn: "Files stay in place",
    leadJa: "元ファイル完全保護",
  },
  {
    id: "ai",
    num: "03 / 08",
    img: "/assets/shots/shot-ai-search.png",
    alt: "Local Visual AI Embedding & OKLab Color Search",
    titleZh: "離線 AI 搜圖",
    titleEn: "Offline AI",
    titleJa: "オフライン AI",
    leadZh: "色票與視覺向量",
    leadEn: "Color & visual vectors",
    leadJa: "色票と類似ベクトル",
  },
  {
    id: "board",
    num: "04 / 08",
    img: "/assets/board.png",
    alt: "Infinite Reference Board",
    titleZh: "無限參考白板",
    titleEn: "Infinite Board",
    titleJa: "無限ボード",
    leadZh: "自由排布與標註",
    leadEn: "Freeform GPU canvas",
    leadJa: "自由に配置・注釈",
  },
  {
    id: "refwin",
    num: "05 / 08",
    img: "/assets/refwin.png",
    alt: "Always-on-Top Floating Reference Window",
    titleZh: "置頂浮動參考窗",
    titleEn: "Floating Ref",
    titleJa: "最前面参照窓",
    leadZh: "半透明伴隨創作",
    leadEn: "Always on top",
    leadJa: "半透明で常駐表示",
  },
  {
    id: "clipper",
    num: "06 / 08",
    img: "/assets/shots/shot-browser-ext.png",
    alt: "Browser Companion Extension & Offline Inbox",
    titleZh: "瀏覽器一鍵存圖",
    titleEn: "Web Clipper",
    titleJa: "ブラウザ拡張",
    leadZh: "支援離線收件匣",
    leadEn: "Offline inbox ready",
    leadJa: "オフライン保存対応",
    ctaHref: "/docs#extension",
    ctaZh: "安裝教學 →",
    ctaEn: "Install guide →",
    ctaJa: "導入手順 →",
  },
  {
    id: "e2ee",
    num: "07 / 08",
    img: "/assets/shots/shot-selfhost-e2ee.png",
    alt: "Self-Hosted Zero-Knowledge AES-256-GCM Sync",
    titleZh: "自架零知識加密",
    titleEn: "Self-Host E2EE",
    titleJa: "ゼロ知識同期",
    leadZh: "預設 AES-256",
    leadEn: "AES-256 by default",
    leadJa: "AES-256 標準搭載",
    ctaHref: "/docs#self-host",
    ctaZh: "自架指南 →",
    ctaEn: "Self-host docs →",
    ctaJa: "構築ガイド →",
  },
  {
    id: "plugins",
    num: "08 / 08",
    img: "/assets/shots/shot-plugins.png",
    alt: "Open Plugin Marketplace",
    titleZh: "開放插件市集",
    titleEn: "Open Plugins",
    titleJa: "プラグイン市場",
    leadZh: "一鍵安裝擴充",
    leadEn: "1-click extensions",
    leadJa: "1クリック拡張",
    ctaHref: "https://github.com/Batkixni/raglex-plugins",
    ctaExt: true,
    ctaZh: "瀏覽市集 ↗",
    ctaEn: "Browse registry ↗",
    ctaJa: "一覧を見る ↗",
  },
];
---

<BaseLayout
  titleZh="Raglex — 靈感，原處收藏"
  titleEn="Raglex — Every reference, yours"
  titleJa="Raglex — 発想を、そのまま"
  description="純原生 Go + MyGo 視覺素材庫、離線 AI 搜圖、無限白板與 Self-Host AES-256 加密同步。"
  activeNav="home"
>
  <main>
    <!-- Act 1: Full-Viewport Phi-Style Hero -->
    <section class="phi-hero">
      <div class="phi-hero-backdrop" aria-hidden="true">
        <div class="phi-hero-aura"></div>
      </div>

      <div class="phi-hero-content">
        <div class="phi-hero-logo-wrap" aria-hidden="true">
          <img src="/assets/app-icon.png" alt="Raglex" class="phi-hero-logo" />
        </div>

        <h1 class="phi-hero-title">
          <span data-lang-block="zh-Hant">靈感，<span class="phi-accent-word">原處</span>收藏</span>
          <span data-lang-block="en">Every reference, <span class="phi-accent-word">yours</span></span>
          <span data-lang-block="ja">発想を、<span class="phi-accent-word">そのまま</span></span>
        </h1>

        <p
          class="phi-hero-sub"
          data-i18n-zh="純原生 · 索引不複製 · 離線 AI · 自架加密"
          data-i18n-en="Native Go · Zero Copy · Offline AI · Self-Host E2EE"
          data-i18n-ja="純ネイティブ · 非破壊管理 · 端末AI · 暗号同期"
        >
          純原生 · 索引不複製 · 離線 AI · 自架加密
        </p>

        <div class="phi-cta-stack">
          <a id="hero-download-btn" href="#download" class="glass-cta">
            <span class="cta-label">下載 Windows 版 (v{version})</span>
          </a>
          <a href={`https://github.com/Batkixni/Raglex/releases/tag/v${version}`} target="_blank" rel="noopener noreferrer" class="phi-release-link">
            <span data-i18n-zh="更新日誌 →" data-i18n-en="Release Notes →" data-i18n-ja="リリースノート →">更新日誌 →</span>
          </a>
        </div>

        <div class="phi-hero-meta mono">
          <span data-i18n-zh={`Go + MyGo 原生核心 · v${version} · MPL-2.0`} data-i18n-en={`Go + MyGo Native · v${version} · MPL-2.0`} data-i18n-ja={`Go + MyGo ネイティブ · v${version} · MPL-2.0`}>
            Go + MyGo 原生核心 · v{version} · MPL-2.0
          </span>
        </div>
      </div>

      <div class="phi-hero-bottom">
        <a href="#download" data-i18n-zh="Windows / macOS / Linux" data-i18n-en="Windows / macOS / Linux" data-i18n-ja="Windows / macOS / Linux">Windows / macOS / Linux</a>
        <span>·</span>
        <a href="/docs#extension" data-i18n-zh="瀏覽器擴充" data-i18n-en="Web Clipper" data-i18n-ja="ブラウザ拡張">瀏覽器擴充</a>
        <span>·</span>
        <a href="/docs#self-host" data-i18n-zh="Self-Host 指南" data-i18n-en="Self-Host Guide" data-i18n-ja="Self-Host 構築">Self-Host 指南</a>
      </div>
    </section>

    <!-- Act 2: Sticky Split Scrollytelling Showcase (8 Real v0.5.1 Screens) -->
    <section id="features" class="showcase">
      <div class="container showcase-grid">
        <!-- Left Sticky Copy + Thumbnail Rail -->
        <div class="showcase-left">
          <div class="stage-copy-stack">
            {
              stages.map((s, idx) => (
                <div class={`stage-copy${idx === 0 ? " is-active" : ""}`} data-copy-idx={idx}>
                  <div class="stage-index">{s.num}</div>
                  <h2 class="stage-h2" data-i18n-zh={s.titleZh} data-i18n-en={s.titleEn} data-i18n-ja={s.titleJa}>
                    {s.titleZh}
                  </h2>
                  <p class="stage-lead" data-i18n-zh={s.leadZh} data-i18n-en={s.leadEn} data-i18n-ja={s.leadJa}>
                    {s.leadZh}
                  </p>
                  {s.ctaHref && (
                    <a
                      href={s.ctaHref}
                      target={s.ctaExt ? "_blank" : undefined}
                      rel={s.ctaExt ? "noopener noreferrer" : undefined}
                      class="stage-cta"
                      data-i18n-zh={s.ctaZh}
                      data-i18n-en={s.ctaEn}
                      data-i18n-ja={s.ctaJa}
                    >
                      {s.ctaZh}
                    </a>
                  )}
                </div>
              ))
            }
          </div>

          <div class="thumb-rail" role="tablist" aria-label="Feature screens">
            {
              stages.map((s, idx) => (
                <button
                  type="button"
                  class={`thumb-btn${idx === 0 ? " is-active" : ""}`}
                  data-thumb-idx={idx}
                  aria-label={s.titleEn}
                >
                  <img src={s.img} alt={s.alt} loading="lazy" />
                </button>
              ))
            }
          </div>
        </div>

        <!-- Right Scrollable Showcase Cards -->
        <div class="showcase-right">
          {
            stages.map((s, idx) => (
              <div id={`stage-${s.id}`} class={`stage-card${idx === 0 ? " is-active" : ""}`} data-card-idx={idx}>
                <div class="stage-card-mobile-head">
                  <div class="stage-index">{s.num}</div>
                  <h2 class="stage-h2" data-i18n-zh={s.titleZh} data-i18n-en={s.titleEn} data-i18n-ja={s.titleJa}>
                    {s.titleZh}
                  </h2>
                  <p class="stage-lead" data-i18n-zh={s.leadZh} data-i18n-en={s.leadEn} data-i18n-ja={s.leadJa}>
                    {s.leadZh}
                  </p>
                </div>
                <div class="stage-frame">
                  <img src={s.img} alt={s.alt} loading={idx === 0 ? "eager" : "lazy"} />
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- Act 3: Minimal Download & Honest macOS Signing Notice -->
    <section id="download" class="dl-band">
      <div class="container">
        <div class="dl-head">
          <div>
            <span class="eyebrow">v{version}</span>
            <h2 class="dl-h2" data-i18n-zh="立即下載" data-i18n-en="Download" data-i18n-ja="ダウンロード">立即下載</h2>
          </div>
          <a href="/docs" class="phi-release-link">
            <span data-i18n-zh="完整文件 →" data-i18n-en="Full Docs →" data-i18n-ja="ドキュメント →">完整文件 →</span>
          </a>
        </div>

        <div class="os-grid">
          <div class="os-card" data-os-card="windows">
            <div class="os-head">
              <span class="os-name">Windows</span>
              <span class="rec-badge" style="display:none" data-i18n-zh="推薦" data-i18n-en="Recommended" data-i18n-ja="推奨">推薦</span>
            </div>
            <a class="dl-row" href={`${releaseBase}/raglex-setup-${version}-amd64.exe`}>
              <span>Windows x64 (Setup)</span>
              <span class="dl-ext">.exe</span>
            </a>
            <a class="dl-row" href={`${releaseBase}/Raglex-windows-amd64.zip`}>
              <span>Windows x64 (Portable)</span>
              <span class="dl-ext">.zip</span>
            </a>
            <a class="dl-row" href={`${releaseBase}/raglex-setup-${version}-arm64.exe`}>
              <span>Windows ARM64</span>
              <span class="dl-ext">.exe</span>
            </a>
          </div>

          <div class="os-card" data-os-card="macos">
            <div class="os-head">
              <span class="os-name">macOS</span>
              <span class="rec-badge" style="display:none" data-i18n-zh="推薦" data-i18n-en="Recommended" data-i18n-ja="推奨">推薦</span>
            </div>
            <a class="dl-row" href={`${releaseBase}/Raglex-darwin-arm64.zip`}>
              <span>Apple Silicon</span>
              <span class="dl-ext">.app.zip</span>
            </a>
            <a class="dl-row" href={`${releaseBase}/Raglex-darwin-amd64.zip`}>
              <span>Intel Mac</span>
              <span class="dl-ext">.app.zip</span>
            </a>
          </div>

          <div class="os-card" data-os-card="linux">
            <div class="os-head">
              <span class="os-name">Linux</span>
              <span class="rec-badge" style="display:none" data-i18n-zh="推薦" data-i18n-en="Recommended" data-i18n-ja="推奨">推薦</span>
            </div>
            <a class="dl-row" href={`${releaseBase}/raglex_${version}_amd64.deb`}>
              <span>Debian / Ubuntu</span>
              <span class="dl-ext">.deb</span>
            </a>
            <a class="dl-row" href={`${releaseBase}/raglex-${version}-1.x86_64.rpm`}>
              <span>Fedora / RHEL</span>
              <span class="dl-ext">.rpm</span>
            </a>
            <a class="dl-row" href={`${releaseBase}/raglex-${version}-linux-amd64.tar.gz`}>
              <span>Linux x64</span>
              <span class="dl-ext">.tar.gz</span>
            </a>
          </div>
        </div>

        <div class="extras-bar">
          <strong style="font-size:13px" data-i18n-zh="擴充與校驗" data-i18n-en="Extensions & SHA256" data-i18n-ja="拡張と検証">擴充與校驗</strong>
          <div class="extras-links">
            <a class="pill-link" href={`${releaseBase}/raglex-browser-extension.zip`}>Chrome / Edge (.zip)</a>
            <a class="pill-link" href={`${releaseBase}/raglex-firefox-extension.xpi`}>Firefox / Zen (.xpi)</a>
            <a class="pill-link" href={`https://github.com/Batkixni/Raglex/releases/tag/v${version}`} target="_blank" rel="noopener noreferrer">
              SHA256SUMS ↗
            </a>
          </div>
        </div>

        <!-- Concise Transparent macOS Unsigned Notice -->
        <div class="callout callout-warn">
          <h3 class="callout-title" data-i18n-zh="macOS 提示" data-i18n-en="macOS Note" data-i18n-ja="macOS 警告">macOS 提示</h3>
          <div data-lang-block="zh-Hant">
            <p>保證無惡意代碼且 100% 開源；因未購買 Apple 開發者認證，macOS 首次開啟會顯示安全警告，不影響使用。若有疑慮，歡迎自行編譯或不使用。</p>
          </div>
          <div data-lang-block="en">
            <p>100% open source with zero malicious code. Without a paid Apple Developer certificate, macOS shows an unsigned warning on first launch. Audit and build from source anytime, or skip if concerned.</p>
          </div>
          <div data-lang-block="ja">
            <p>100% オープンソースで悪意あるコードはありません。有料の Apple 署名がないため初回起動時に警告が出ます。不安な場合はソースからビルドするかご利用をお控えください。</p>
          </div>
          <CodeBlock id="mac-xattr-home" label="macOS Terminal" code="xattr -cr /Applications/Raglex.app" compact />
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
