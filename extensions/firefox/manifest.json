{
  "manifest_version": 3,
  "name": "Raglex Web Clipper",
  "version": "0.5.2",
  "description": "Save webpages, multi-platform sources, screenshots, and page images directly into Raglex tags, projects, and boards.",
  "browser_specific_settings": {
    "gecko": {
      "id": "raglex-web-clipper@raglex.dev",
      "strict_min_version": "109.0"
    }
  },
  "permissions": [
    "contextMenus",
    "activeTab",
    "storage",
    "scripting",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Raglex Web Clipper"
  }
}
